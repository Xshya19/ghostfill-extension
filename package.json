{
  "name": "ghostfill-extension",
  "version": "1.1.5",
  "description": "Chrome extension for disposable email, password generation, and deterministic OTP extraction during signup verification.",
  "private": true,
  "homepage": "https://github.com/Xshya19/ghostfill-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xshya19/ghostfill-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Xshya19/ghostfill-extension/issues"
  },
  "scripts": {
    "dev": "webpack --watch --mode=development",
    "logs": "node scripts/log_server.js",
    "build": "npm run clean && webpack --env profile=full --mode=production",
    "build:public": "npm run clean && webpack --env profile=public --mode=production",
    "bundle:check": "node scripts/check-bundle-size.js",
    "build:dev": "npm run clean && webpack --env profile=full --mode=development",
    "build:full": "npm run build",
    "build:full:dev": "npm run build:dev",
    "build:public:dev": "npm run clean && webpack --env profile=public --mode=development",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format:check": "prettier --check \"*.{json,md,cjs,js,ts}\" \"{src,scripts,tests,public}/**/*.{ts,tsx,js,cjs,json,css,html,md}\"",
    "workflow:check": "node scripts/validate-workflows.cjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "eval": "tsx src/intelligence/eval/runEval.ts --sample",
    "benchmark:extraction": "tsx scripts/benchmark-extraction.ts",
    "clean": "rimraf dist",
    "zip": "node scripts/build-zip.js",
    "icons:brand": "python scripts/update-brand-icons.py",
    "build:zip": "npm run build && npm run zip",
    "build:public:zip": "npm run build:public && npm run zip"
  },
  "keywords": [
    "chrome-extension",
    "disposable-email",
    "temporary-email",
    "temp-mail",
    "temp-email",
    "disposable-email-chrome-extension",
    "otp-autofill",
    "otp-detection",
    "automatic-otp-fill",
    "verification-code-autofill",
    "magic-link",
    "magic-link-autofill",
    "activation-link",
    "password-generator",
    "secure-password",
    "gmail-alias",
    "gmail-dot-alias",
    "gmail-plus-alias",
    "anti-spam",
    "anti-tracking",
    "privacy-extension",
    "privacy-tools",
    "manifest-v3",
    "autofill",
    "form-autofill",
    "browser-extension",
    "chromium-extension",
    "open-source",
    "web-security",
    "spam-protection",
    "react",
    "typescript",
    "zustand",
    "framer-motion"
  ],
  "author": {
    "name": "GhostFill",
    "url": "https://github.com/Xshya19"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.16",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "csv-parse": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
