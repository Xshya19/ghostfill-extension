{
  "name": "ghostfill-extension",
  "version": "1.1.0",
  "description": "GhostFill: Privacy-first Chrome Extension - Instant disposable temporary emails, cryptographically secure passwords, automatic OTP code detection & autofill, Gmail dot/plus alias support, and magic activation link auto-opening. Manifest V3. 17 temp mail backends. 100% local heuristics. Zero cloud tracking. Free & Open Source.",
  "private": true,
  "homepage": "https://github.com/Xshya19/ghostfill-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xshya19/ghostfill-extension.git"
  },
  "bugs": {
    "url": "https://github.com/Xshya19/ghostfill-extension/issues"
  },
  "scripts": {
    "dev": "webpack --watch --mode=development",
    "logs": "node scripts/log_server.js",
    "build": "npm run clean && webpack --mode=production",
    "build:dev": "npm run clean && webpack --mode=development",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format:check": "prettier --check \"*.{json,md,cjs,js,ts}\" \"{src,scripts,tests,public}/**/*.{ts,tsx,js,cjs,json,css,html,md}\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "eval": "tsx src/intelligence/eval/runEval.ts --sample",
    "clean": "rimraf dist",
    "zip": "node scripts/build-zip.js",
    "icons:brand": "python scripts/update-brand-icons.py",
    "build:zip": "npm run build && npm run zip"
  },
  "keywords": [
    "chrome-extension",
    "disposable-email",
    "temporary-email",
    "temp-mail",
    "temp-email",
    "disposable-email-chrome-extension",
    "otp-autofill",
    "otp-detection",
    "automatic-otp-fill",
    "verification-code-autofill",
    "magic-link",
    "magic-link-autofill",
    "activation-link",
    "password-generator",
    "secure-password",
    "gmail-alias",
    "gmail-dot-alias",
    "gmail-plus-alias",
    "anti-spam",
    "anti-tracking",
    "privacy-extension",
    "privacy-tools",
    "manifest-v3",
    "autofill",
    "form-autofill",
    "browser-extension",
    "chromium-extension",
    "open-source",
    "web-security",
    "spam-protection",
    "react",
    "typescript",
    "zustand",
    "framer-motion"
  ],
  "author": {
    "name": "GhostFill",
    "url": "https://github.com/Xshya19"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.3.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.254",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.19.37",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.2",
    "archiver": "^7.0.1",
    "clean-css": "^5.3.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "csv-parse": "^6.2.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^4.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^29.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "protobufjs": "^7.6.2",
    "@protobufjs/utf8": "^1.1.1",
    "brace-expansion": "^5.0.6",
    "fast-uri": "^3.1.2"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "protobufjs@7.6.2": true
  }
}
